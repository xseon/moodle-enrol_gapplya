{{! --- STATUS MESSAGES --- }}

{{#noenrolment}}
<div class="alert alert-danger mt-3">
    <div class="media">
        <div class="mr-3 icon-size-5"><i class="fa fa-ban fa-2x"></i></div>
        <div class="media-body align-self-center">{{#str}}cannotenrol, enrol_gapplya{{/str}}</div>
    </div>
</div>
{{/noenrolment}}

{{#expired}}
<div class="alert alert-danger mt-3">
    <div class="media">
        <div class="mr-3 icon-size-5"><i class="fa fa-ban fa-2x"></i></div>
        <div class="media-body align-self-center">{{#str}}enrolmentexpired, enrol_gapplya, {{enrolmentend}}{{/str}}</div>
    </div>
</div>
{{/expired}}

{{#suspended}}
<div class="alert alert-danger mt-3">
    <div class="media">
        <div class="mr-3 icon-size-5"><i class="fa fa-ban fa-2x"></i></div>
        <div class="media-body align-self-center">{{#str}}enrolmentsuspended, enrol_gapplya{{/str}}</div>
    </div>
</div>
{{/suspended}}

{{#new}}
<div class="alert alert-info mt-3">
    <div class="media">
        <div class="mr-3 icon-size-5"><i class="fa fa-file-lines fa-2x"></i></div>
        <div class="media-body align-self-center">{{#str}}alreadyapplied, enrol_gapplya, {{time}}{{/str}}</div>
    </div>
</div>
{{/new}}

{{#approved}}
<div class="alert alert-success mt-3">
    <div class="media">
        <div class="mr-3 icon-size-5"><i class="fa fa-file-circle-check fa-2x"></i></div>
        <div class="media-body align-self-center">{{#str}}enrollmentapproved, enrol_gapplya, {{enrolmentstart}}{{/str}}</div>
    </div>
</div>
{{/approved}}

{{#waitlisted}}
<div class="alert alert-warning mt-3">
    <div class="media">
        <div class="mr-3 icon-size-5"><i class="fa fa-file-circle-question fa-2x"></i></div>
        <div class="media-body align-self-center">{{#str}}youhavebeenwaitlisted, enrol_gapplya, {{time}}{{/str}}</div>
    </div>
</div>
{{/waitlisted}}

{{#rejected}}
<div class="alert alert-danger mt-3">
    <div class="media">
        <div class="mr-3 icon-size-5"><i class="fa fa-file-circle-xmark fa-2x"></i></div>
        <div class="media-body align-self-center">{{#str}}youhavebeenrejected, enrol_gapplya, {{time}}{{/str}}</div>
    </div>
</div>
{{/rejected}}

{{! --- APPLICATION CONTENT --- }}
{{#hasapplication}}
<div class="bg-white border p-3 rounded text-dark mb-3">
    <h5 class="border-bottom pb-2 mb-3">{{#str}}applicationdetails, enrol_gapplya{{/str}}</h5>
    
    <div class="application-content">
        {{{applytext}}}
    </div>
</div>
{{/hasapplication}}

{{! --- WITHDRAW BUTTON --- }}
{{#allowwithdrawal}}
<div class="clearfix mb-3">
    <a href="{{config.wwwroot}}/enrol/index.php?id={{courseid}}&withdraw=1&sesskey={{sesskey}}" 
	   class="btn btn-danger float-right" 
	   onclick="return confirm('{{#str}}withdrawapplicationconfirm, enrol_gapplya{{/str}}'.replace(/<br\s*\/?>/gi, '\n'));">
		<i class="fa fa-file-circle-minus fa-fw mr-1"></i> {{#str}}withdrawmyapplication, enrol_gapplya{{/str}}
	</a>
</div>
{{/allowwithdrawal}}

{{#js}}
require(['enrol_gapplya/previewfile'], function(previewfile) {
    previewfile.init();
});
{{/js}}