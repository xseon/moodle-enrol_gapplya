<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="enrol/gapplya/db" VERSION="20260204" COMMENT="XMLDB file for Moodle enrol/gapplya"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="enrol_gapplya" COMMENT="Stores enrollment applications and custom data">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="instance" TYPE="int" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="applytext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="format" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="applyfile" TYPE="int" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="new" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        
        <FIELD NAME="json_data" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Stores dynamic form responses in JSON format"/>
        <FIELD NAME="history" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Full audit log history of changes"/>
        <FIELD NAME="adminnote" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Internal administrative notes"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>